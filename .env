# ============================================================
# AI Saham Indonesia — Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# Command: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Aplikasi
# ------------------------------------------------------------
APP_NAME=AI Saham Indonesia
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8080

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saham_db
POSTGRES_USER=saham_user
POSTGRES_PASSWORD=saham_secret_2024

# URL lengkap (di-generate otomatis di config.py, tapi bisa di-override)
# DATABASE_URL=postgresql+asyncpg://saham_user:saham_secret_2024@localhost:5432/saham_db

# ------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Autentikasi (opsional, kosongkan jika tidak dipakai)
CHROMA_SERVER_AUTHN_CREDENTIALS=
CHROMA_SERVER_AUTHN_PROVIDER=

# ------------------------------------------------------------
# Ollama — LLM Lokal (Qwen3 8B)
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192            # Context window size
OLLAMA_TIMEOUT=120             # Timeout dalam detik

# ------------------------------------------------------------
# Embedding — BGE-M3
# ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=mps           # mps (Apple Silicon) | cpu | cuda
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------
# Scheduler — APScheduler
# ------------------------------------------------------------
# Scoring dijalankan setiap Senin pagi
SCORING_CRON_DAY_OF_WEEK=mon
SCORING_CRON_HOUR=6
SCORING_CRON_MINUTE=0

# Scraping berita dijalankan setiap 30 menit
NEWS_SCRAPE_INTERVAL_MINUTES=30

# Alert monitoring interval
ALERT_CHECK_INTERVAL_MINUTES=30

# ------------------------------------------------------------
# Scoring Engine — Bobot Default (bisa di-override oleh agent)
# ------------------------------------------------------------
SCORE_WEIGHT_FUNDAMENTAL=0.40
SCORE_WEIGHT_SEKTOR=0.20
SCORE_WEIGHT_MAKRO=0.25
SCORE_WEIGHT_RISIKO=0.15

# Jumlah saham dalam rekomendasi
TOP_K_SAHAM=10

# ------------------------------------------------------------
# Data Sources — API Keys & URLs
# ------------------------------------------------------------
# Yahoo Finance (tidak perlu API key)
YFINANCE_MARKET_SUFFIX=.JK    # Suffix untuk saham IDX di Yahoo Finance

# Kontan RSS
KONTAN_RSS_URL=https://www.kontan.co.id/rss

# IDX API
IDX_API_BASE_URL=https://www.idx.co.id/primary/ListedCompany

# Google News RSS (topik: saham indonesia)
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search?q=saham+indonesia&hl=id&gl=ID&ceid=ID:id

# Bank Indonesia API
BI_API_BASE_URL=https://www.bi.go.id/api

# BPS API
BPS_API_BASE_URL=https://webapi.bps.go.id/v1

# ------------------------------------------------------------
# Tailscale VPN (untuk akses dari iPhone)
# ------------------------------------------------------------
TAILSCALE_HOSTNAME=
# Jika menggunakan MagicDNS, akses API di: http://<hostname>:8080
